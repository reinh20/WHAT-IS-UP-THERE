# This .gitignore file is configured for Unity projects
# Ignore Unity temporary & generated cache folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated VS / IDE solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vs/
.vscode/
.idea/

# Asset meta data should NEVER be ignored in Unity
!/[Aa]ssets/**/*.meta

